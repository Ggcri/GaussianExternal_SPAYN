! =======================================================
! Test case for COMPLEX FORMULA in MolproExt_project
! =======================================================
! Test: Complex non-linear combination like MRCC example
! Expected: E_final = sqrt(c1²*E_hf² + c2²*E_mp2² + c3²*E_ccsd²)

!scheme
! 1.0 2.0 0.5
!formula
!e=sqrt(c1*c1*e1*e1 + c2*c2*e2*e2 + c3*c3*e3*e3)
!end

basis=cc-pvdz
memory,1000,m

{hf
wf,10,1,0}

{mp2
wf,10,1,0}

{ccsd
wf,10,1,0}