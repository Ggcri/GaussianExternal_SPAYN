mass,iso ! to be sure most abundant isotopes are used

basis={
  default=VTZ-F12
  Br=VTZ-PP-F12
  I=VTZ-PP-F12
  Kr=VTZ-PP-F12

  set,jkfit,context=jkfit
  default=avtz/jkfit
  O=avtz/jkfit
  Br=vtz-pp/jkfit
  I=vtz-pp/jkfit
  Kr=vtz-pp/jkfit

  set,mp2fit,context=mp2fit
  default=avtz/mp2fit
  O=avtz/mp2fit
  Br=vtz-pp/mp2fit
  I=vdt-pp/mp2fit
  Kr=vtz-pp/mp2fit
}

!!!!  cDFTc=0.4210
!!!!  cXHF=0.69
!!!!  c2ab=0.5922
!!!!  c2ss=0.0636
!!!!  {DF-ks,pbex,p86;dh,cXHF,1.00-cDFTc}
!!!!  EKS=ENERGY;
!!!!  
!!!!  DF-mp2,ksfock,scsfacs=c2ab/(1.00-cDFTc),scsfact=c2ss/(1.00-cDFTc)
!!!!  PT2=(EMP2_SCS - ENERGR)*(1.00-cDFTc)
!!!!  TOTAL_ENERGY=EKS+PT2
!!!!  exe_energy=TOTAL_ENERGY

  {hf,so-sci} 
  {DF-MP2}
  exe_energy=energy
