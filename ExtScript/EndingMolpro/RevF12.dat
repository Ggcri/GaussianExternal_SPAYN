
mass,iso ! to be sure most abundant isotopes are used

basis={
  default=VDZ-F12
  Br=VDZ-PP-F12
  I=VDZ-PP-F12
  Kr=VDZ-PP-F12

  set,jkfit,context=jkfit
  default=avdz/jkfit
  O=avdz/jkfit
  Br=vdz-pp/jkfit
  I=vdz-pp/jkfit
  Kr=vdz-pp/jkfit

  set,mp2fit,context=mp2fit
  default=avdz/mp2fit
  O=avdz/mp2fit
  Br=vdz-pp/mp2fit
  I=vdz-pp/mp2fit
  Kr=vdz-pp/mp2fit
}
