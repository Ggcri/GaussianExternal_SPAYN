mass,iso ! to be sure most abundant isotopes are used
basis,cc-pVDZ-F12
!,Br=cc-pVTZ-PP-F12, I=cc-pVTZ-PP-F12, Kr=cc-pVTZ-PP-F12
basis={
jkfit=cc-pVDZ/JKFIT   ! Base JKFIT ausiliaria per tutti gli atomi
}
cDFTc=0.4210
cXHF=0.69
c2ab=0.5922
c2ss=0.0636
{DF-ks,pbex,p86,gridthr=1d-6,gridthr=3d-7;dh,cXHF,1.00-cDFTc}
EKS=ENERGY;
eks_1=ENERGY;
dispcorr4 
eks=eks_1+edisp
df-cabs
PNO-LMP2-F12, GEM_BETA=1.0 ,ksfock,scsfacs=c2ab/(1.00-cDFTc),scsfact=c2ss/(1.00-cDFTc)
eglptf12=(ENERGY-ENERGR)*0.36
ecabs=EF12_SINGLES
exe_energy=eks+eglptf12+ecabs
show, *
